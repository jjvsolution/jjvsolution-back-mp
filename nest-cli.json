{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/jjvsolution-back-mp/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/jjvsolution-back-mp/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/jjvsolution-back-mp",
  "projects": {
    "access-control": {
      "type": "application",
      "root": "apps/access-control",
      "entryFile": "main",
      "sourceRoot": "apps/access-control/src",
      "compilerOptions": {
        "tsConfigPath": "apps/access-control/tsconfig.app.json"
      }
    },
    "admin": {
      "type": "application",
      "root": "apps/admin",
      "entryFile": "main",
      "sourceRoot": "apps/admin/src",
      "compilerOptions": {
        "tsConfigPath": "apps/admin/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "jjvsolution-back-mp": {
      "type": "application",
      "root": "apps/jjvsolution-back-mp",
      "entryFile": "main",
      "sourceRoot": "apps/jjvsolution-back-mp/src",
      "compilerOptions": {
        "tsConfigPath": "apps/jjvsolution-back-mp/tsconfig.app.json"
      }
    },
    "landing": {
      "type": "application",
      "root": "apps/landing",
      "entryFile": "main",
      "sourceRoot": "apps/landing/src",
      "compilerOptions": {
        "tsConfigPath": "apps/landing/tsconfig.app.json"
      }
    },
    "payment-portal": {
      "type": "application",
      "root": "apps/payment-portal",
      "entryFile": "main",
      "sourceRoot": "apps/payment-portal/src",
      "compilerOptions": {
        "tsConfigPath": "apps/payment-portal/tsconfig.app.json"
      }
    },
    "quotation": {
      "type": "application",
      "root": "apps/quotation",
      "entryFile": "main",
      "sourceRoot": "apps/quotation/src",
      "compilerOptions": {
        "tsConfigPath": "apps/quotation/tsconfig.app.json"
      }
    }
  }
}