// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "darwin-arm64", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TypeParameter {
  STRING  @map("String")
  NUMBER  @map("Number")
  DATE    @map("Date")
  BOOLEAN @map("Boolean")
  OBJECT  @map("Object")
  ARRAY   @map("Array")
}

model Parameter {
  id          Int           @id @default(autoincrement())
  idParameter String        @unique
  name        String
  value       String
  group       String
  type        TypeParameter
}

model CodeError {
  id           Int    @id @default(autoincrement())
  code         String
  internalCode String
  message      String
  type         String
  language     String @default("en")
}

model Error {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  responseBody String   @db.Text
  error        String   @db.Text
  url          String
  body         String   @db.Text
  params       String   @db.Text
  headers      String   @db.Text
  type         String
  requestUser  String?
  stack        String?  @db.Text
}

model Log {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  categoryName String
  data         String   @db.Text
  url          String   @db.Text
  method       String
  code         Int?
  error        String   @db.Text
  level        String
}

// Access Control con prefijo AC
model ACUser {
  id                      String                      @id @default(uuid()) @db.Uuid
  email                   String?                     @unique
  firstName               String?
  lastName                String?
  fullName                String?
  picture                 String?
  twofa_auth_url          String?
  twofa_base32            String?
  twofa_enabled           Boolean?
  twofa_verified          Boolean?
  isDeleted               Boolean                     @default(false)
  Token                   ACToken[]
  LoginType               ACLoginType[]
  UserProfileApplications ACUserProfileApplications[]
}

model ACLoginType {
  id        Int       @id @default(autoincrement())
  type      TypeToken
  username  String
  password  String?   @db.VarChar(100)
  isDeleted Boolean   @default(false)
  User      ACUser?   @relation(fields: [userId], references: [id])
  userId    String    @db.Uuid
  @@unique([type, username])
}

model ACToken {
  id           Int       @id @default(autoincrement())
  type         TypeToken
  token        String    @db.Text
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  openId       String?
  isDeleted    Boolean   @default(false)
  User         ACUser?   @relation(fields: [userId], references: [id])
  userId       String    @db.Uuid
}

enum TypeToken {
  local     @map("Type de Local")
  google    @map("Type de Google")
  github    @map("Type de Github")
  microsoft @map("Type de Microsoft")
  facebook  @map("Type de Facebook")
  instagram @map("Type de Instagram")
}

model ACCompanies {
  id                    Int                       @id @default(autoincrement())
  name                  String
  rut                   String
  isDeleted             Boolean                   @default(false)
  CompaniesParent       ACCompanies?              @relation("CompaniesChildren", fields: [CompaniesParentId], references: [id])
  CompaniesParentId     Int?
  Companies             ACCompanies[]             @relation("CompaniesChildren")
  ApplicationsCompanies ACApplicationsCompanies[]
}

model ACApplications {
  id                        String                    @id @default(uuid()) @db.Uuid
  name                      String
  description               String?
  url                       String?
  isDeleted                 Boolean                   @default(false)
  Profiles                  ACProfiles[]
  ApplicationsCompanies     ACApplicationsCompanies[]
  ConfigAuthApplication     ACConfigAuthApplication?  @relation(fields: [aCConfigAuthApplicationId], references: [id])
  aCConfigAuthApplicationId Int?
}

model ACConfigAuthApplication {
  id             Int              @id @default(autoincrement())
  jwt            Json? // { PRIVATE_KEY: string; PUBLIC_KEY: string; JWT_EXPIRES_IN: string; }
  google         Json? // { GOOGLE_CLIENT_ID: string; GOOGLE_CLIENT_SECRET: string; }
  github         Json? // { GITHUB_CLIENT_ID: string; GITHUB_CLIENT_SECRET: string; }
  facebook       Json? // { FACEBOOK_CLIENT_ID: string; FACEBOOK_CLIENT_SECRET: string; }
  linkedin       Json? // { LINKEDIN_CLIENT_ID: string; LINKEDIN_CLIENT_SECRET: string; }
  apple          Json? // { APPLE_CLIENT_ID: string; APPLE_CLIENT_SECRET: string; }
  twitter        Json? // { TWITTER_CLIENT_ID: string; TWITTER_CLIENT_SECRET: string; }
  microsoft      Json? // { MICROSOFT_CLIENT_ID: string; MICROSOFT_CLIENT_SECRET: string; }
  ACApplications ACApplications[]
}

model ACProfiles {
  id                      Int                         @id @default(autoincrement())
  name                    String
  details                 String?
  isDeleted               Boolean                     @default(false)
  Applications            ACApplications              @relation(fields: [applicationsId], references: [id])
  applicationsId          String                      @db.Uuid
  UserProfileApplications ACUserProfileApplications[]
  RolsProfiles            ACRolsProfiles[]
}

model ACRolsProfiles {
  id        Int        @id @default(autoincrement())
  Profiles  ACProfiles @relation(fields: [profileId], references: [id])
  profileId Int
  Rols      ACRols     @relation(fields: [rolsId], references: [id])
  rolsId    Int
}

model ACRols {
  id           Int              @id @default(autoincrement())
  name         String
  details      String?
  RolsProfiles ACRolsProfiles[]
}

model ACUserProfileApplications {
  id        Int        @id @default(autoincrement())
  Users     ACUser     @relation(fields: [usersId], references: [id])
  usersId   String     @db.Uuid
  Profiles  ACProfiles @relation(fields: [profileId], references: [id])
  profileId Int
}

model ACApplicationsCompanies {
  id             Int            @id @default(autoincrement())
  Companies      ACCompanies    @relation(fields: [companiesId], references: [id])
  companiesId    Int
  Applications   ACApplications @relation(fields: [applicationsId], references: [id])
  applicationsId String         @db.Uuid
}

// portal de pago

enum PPTypeTypeOfCurrency {
  CLP @map("Peso Chileno")
  CLF @map("UF")
  USD @map("Dólar")
}

enum PPTypePaymentType {
  TRANSFER  @map("Transferencia")
  TRANSBANK @map("Transbank")
}

enum PPStatusPayment {
  PENDING   @map("Pendiente")
  COMPLETED @map("Completado")
  FAILED    @map("Fallido")
}

model PPDebtsToPay {
  id          Int           @id @default(autoincrement())
  userId      String
  companyId   Int
  payId       String        @unique
  description String
  DuesofPay   PPDuesOfPay[]
}

model PPDuesOfPay {
  id                  Int                   @id @default(autoincrement())
  expirationDate      DateTime
  description         String
  amount              Float
  TypeOfCurrency      PPTypeTypeOfCurrency
  paid                Boolean               @default(false)
  DebtsToPay          PPDebtsToPay          @relation(fields: [debtsToPayId], references: [id])
  debtsToPayId        Int
  paymentType         PPTypePaymentType?
  PPPaymentDeuesOfPay PPPaymentDeuesOfPay[]
}

model PPPaymentDeuesOfPay {
  id          Int         @id @default(autoincrement())
  payment     PPPayment   @relation(fields: [paymentId], references: [id])
  paymentId   Int
  duesOfPay   PPDuesOfPay @relation(fields: [duesOfPayId], references: [id])
  duesOfPayId Int
}

model PPPayment {
  id                  Int                   @id @default(autoincrement())
  createdAt           DateTime              @default(now())
  paymentDate         DateTime
  paymentType         PPTypePaymentType
  amount              Float
  status              PPStatusPayment
  PPPaymentDeuesOfPay PPPaymentDeuesOfPay[]
}

// Portal My Acceso

model MAAccess {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  userId       String   @db.Uuid
  key          String   @unique
  startDate    DateTime
  endDate      DateTime
  amountPeople Int
  persons      String[] @default([])
}

// Portal cl-external-sources-ms
model ESSource {
  id         Int          @id @default(autoincrement())
  createdAt  DateTime     @default(now())
  validDays  Int
  name       String       @unique
  script     String       @db.Text
  modules    String[]     @default([])
  filter     String[]     @default([])
  ESDocument ESDocument[]
}

model ESDocument {
  id             Int      @id @default(autoincrement())
  expirationDate DateTime
  params         Json
  data           Json
  ESSource       ESSource @relation(fields: [eSSourceId], references: [id])
  eSSourceId     Int
}

// Base de datos para Quotation con prefijo Q
enum TypeTypeProdServ {
  PRODUCT @map("Producto")
  SERVICE @map("Servicio")
}

model QUsers {
  id        Int         @id @default(autoincrement())
  UID       String
  createdAt DateTime    @default(now())
  business  QBusiness[]
  isDeleted Boolean     @default(false)
  QTemplate QTemplate[]
}

model QBusiness {
  id               Int        @id @default(autoincrement())
  createdAt        DateTime   @default(now())
  name             String
  businessName     String
  rut              String     @unique
  users            QUsers?    @relation(fields: [usersId], references: [id])
  usersId          Int
  clients          QClients[]
  address          String
  emails           String?
  emailAdditionals String?
  isDeleted        Boolean    @default(false)
}

model QClients {
  id               Int          @id @default(autoincrement())
  createdAt        DateTime     @default(now())
  name             String
  rut              String       @unique
  address          String
  business         QBusiness?   @relation(fields: [businessId], references: [id])
  businessId       Int
  quotation        QQuotation[]
  emails           String?
  emailAdditionals String?
  isDeleted        Boolean      @default(false)
}

model QQuotation {
  id             Int               @id @default(autoincrement())
  createdAt      DateTime          @default(now())
  folio          String
  title          String
  detail         String
  dateQuote      String
  clients        QClients?         @relation(fields: [clientsId], references: [id])
  clientsId      Int
  ItemsQuotation QItemsQuotation[]
  file           QFile?            @relation(fields: [fileId], references: [id])
  fileId         Int?
  status         QStatus?          @relation(fields: [statusId], references: [id])
  statusId       Int
  isDeleted      Boolean           @default(false)
}

model QItemsQuotation {
  id          Int         @id @default(autoincrement())
  cant        Int
  detail      String      @default("")
  quotation   QQuotation? @relation(fields: [quotationId], references: [id])
  quotationId Int?
  prodServ    QProdServ?  @relation(fields: [prodServId], references: [id])
  prodServId  Int?
  isDeleted   Boolean     @default(false)
}

model QProdServ {
  id             Int               @id @default(autoincrement())
  createdAt      DateTime          @default(now())
  detail         String
  gloss          String            @default("")
  price          Int
  type           TypeTypeProdServ
  itemsQuotation QItemsQuotation[]
  isDeleted      Boolean           @default(false)
}

model QFile {
  id         Int          @id @default(autoincrement())
  createdAt  DateTime     @default(now())
  url        String
  typeFile   QTypeFile?   @relation(fields: [typeFileId], references: [id])
  typeFileId Int
  quotation  QQuotation[]
  isDeleted  Boolean      @default(false)
}

model QTypeFile {
  id        Int     @id @default(autoincrement())
  name      String
  mime      String
  extension String
  file      QFile[]
  isDeleted Boolean @default(false)
}

model QStatus {
  id        Int          @id @default(autoincrement())
  name      String
  key       String
  type      String
  quotation QQuotation[]
  isDeleted Boolean      @default(false)
}

model QTemplate {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  key         String   @unique
  description String
  template    String   @db.Text
  isPrincipal Boolean  @default(false)
  isDeleted   Boolean  @default(false)
  users       QUsers   @relation(fields: [usersId], references: [id])
  usersId     Int
}

// base de datos para Google con prefijo G 
model GOauth2Setting {
  id          Int     @id @default(autoincrement())
  identifier  String
  credentials String  @db.Text
  token       String? @db.Text
  scopes      String
}

model GEmailTemplate {
  id              Int                @id @default(autoincrement())
  templateId      String
  template        String
  subject         String
  templateContact GtemplateContact[]
}

model GContacts {
  id              Int                @id @default(autoincrement())
  name            String
  email           String
  mobilePhone     String?
  templateContact GtemplateContact[]
}

model GtemplateContact {
  id              Int             @id @default(autoincrement())
  emailTemplate   GEmailTemplate? @relation(fields: [emailTemplateId], references: [id])
  emailTemplateId Int
  Contacts        GContacts?      @relation(fields: [contactsId], references: [id])
  contactsId      Int
}
